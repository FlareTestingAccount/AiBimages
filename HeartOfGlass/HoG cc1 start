{{/* ═══ HEARTS OF GLASS · A · START ═══ */}}
{{if not (hasPermissions .Permissions.ManageServer)}}{{return}}{{end}}


{{/* =========================================================================
     Trigger Types
     A(1) command "HoGStart
     B(2) message component "^hog-"
     C(3) command "HoGBegin"
