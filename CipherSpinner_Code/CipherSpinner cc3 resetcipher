{{/* -resetcipher          → wipes EVERYONE, all sets become respinnable
     -resetcipher @user    → frees just that one member                 */}}

{{- if gt (len .Args) 1 -}}
  {{- $t := userArg (index .Args 1) -}}
  {{- if not $t -}}
❌ Couldn't find that member.
  {{- else -}}
    {{- dbDel $t.ID "cipher_set" -}}
    {{- sendMessage nil (cembed
        "title" "♻️ Set Cleared"
        "color" 5763719
        "description" (printf "**%s** can now run `-spin` for a fresh set." $t.Username)
        "thumbnail" (sdict "url" ($t.AvatarURL "256"))
        "footer" (sdict "text" (printf "Reset by %s" .User.Username))) -}}
  {{- end -}}
{{- else -}}
  {{- $new := dbIncr 0 "cipher_gen" 1 -}}
  {{- sendMessage nil (cembed
      "title" "♻️ FULL CIPHER RESET"
      "color" 15548997
      "description" "Every locked set has been invalidated. Everyone may now run `-spin` again."
      "fields" (cslice
        (sdict "name" "New generation" "value" (printf "`#%v`" $new) "inline" true))
      "footer" (sdict "text" (printf "Reset by %s" .User.Username))) -}}
{{- end -}}